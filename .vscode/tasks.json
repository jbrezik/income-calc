{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["install"],
      "problemMatcher": []
    },
    {
      "label": "Review: income calculator",
      "type": "process",
      "command": "npm",
      "windows": { "command": "npm.cmd" },
      "args": ["run", "dev", "--", "--open"],
      "dependsOn": "Install dependencies",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^x" },
        "background": { "beginsPattern": "VITE", "endsPattern": "Local:" }
      }
    },
    {
      "label": "Review: check out a PR",
      "type": "process",
      "command": "gh",
      "args": ["pr", "checkout", "${input:pr}"],
      "problemMatcher": []
    }
  ],
  "inputs": [{ "id": "pr", "type": "promptString", "description": "PR number" }]
}
